# ---- Server ----
PORT=4000
# Comma-separated list of allowed web origins (add capacitor://localhost and http://localhost for the Android app)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost

# ---- Security ----
# Long random string. Used to sign JWTs AND to encrypt API keys / SMTP passwords stored in MySQL.
# Do not change it after go-live, or saved secrets can no longer be decrypted.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=30d

# ---- SQLite ----
SQLITE_DB_PATH=./data/kathai.sqlite

# ---- First admin (created by `npm run migrate` if it does not exist) ----
ADMIN_NAME=Kathai Admin
ADMIN_EMAIL=teamkathai@gmail.com
ADMIN_PASSWORD=ChangeThisAdminPassword!

# ---- Optional bootstrap values (can all be changed later in Admin) ----
# Seeded into the default Gemini Live engine on first migrate
GEMINI_API_KEY=
# Default mail sender, seeded into Admin > Mail settings on first migrate
MAIL_FROM_EMAIL=teamkathai@gmail.com
MAIL_FROM_NAME=Kathai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=teamkathai@gmail.com
# Gmail App Password (16 chars, no spaces). Leave blank here and set it in Admin > Mail if you prefer.
SMTP_PASS=
